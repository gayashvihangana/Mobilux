generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
  STAFF // Phase 2
}

enum TicketStatus {
  SUBMITTED // customer submitted online — awaiting shop acceptance
  CONFIRMED // shop accepted the request — waiting for the device to arrive
  RECEIVED // device is physically at the shop
  DIAGNOSING
  AWAITING_PARTS
  IN_PROGRESS
  COMPLETED
  READY_FOR_PICKUP
  PICKED_UP
  CANCELLED
}

enum DeviceType {
  PHONE
  TABLET
  LAPTOP
  SMARTWATCH
  OTHER
}

// Issue-during-repair (damage/dispute) flow — see reportRepairIssue.
enum RepairIssueStatus {
  PENDING // reported — waiting for the customer's decision
  ACCEPTED // customer accepted the free fix — repair continues
  DECLINED // customer declined (or no fix existed) — cancelled, refund owed
}

enum PaymentMethod {
  PAYHERE
  BANK_TRANSFER
  CASH
}

enum PaymentStatus {
  PENDING
  PENDING_VERIFICATION
  PAID
  REJECTED
  REFUNDED
}

enum ProductCategory {
  ACCESSORY
  PHONE
}

// Customer feedback moderation — nothing reaches the home page until an
// admin approves it. HIDDEN is "was live, taken down" as well as "rejected".
enum TestimonialStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
}

// ─── Core models ─────────────────────────────────────────────────────

model User {
  id                String         @id @default(cuid())
  name              String
  email             String         @unique
  phone             String?
  passwordHash      String
  role              Role           @default(CUSTOMER)
  avatarUrl         String?
  completedRepairs  Int            @default(0)
  lastLoginAt       DateTime? // updated each time the account signs in
  blocked           Boolean        @default(false) // admin can block a customer's login
  unblockRequested  Boolean        @default(false) // blocked customer asked to be unblocked
  // Sessions are stateless JWTs, so there is nothing to delete server-side when
  // access should end. Any token issued before this instant is rejected by
  // lib/auth-guard — bumped on block, password change and password reset, which
  // is what makes those actions take effect immediately instead of in 8 hours.
  sessionsValidFrom DateTime       @default(now())
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  tickets           RepairTicket[]
  payments          Payment[]
  orders            Order[]
  notifications     Notification[]
  testimonials      Testimonial[]
  auditLogs         AuditLog[]
}

model RepairTicket {
  id                  String         @id @default(cuid())
  seq                 Int            @unique @default(autoincrement())
  ticketNumber        String         @unique // MBX-0001 style (legacy imports keep REP-xxxx)
  // Unguessable key for the public tracker. ticketNumber is sequential, so it
  // can be walked from MBX-0001 upward; this cannot. It IS the credential —
  // the link is what the shop hands a walk-in customer who has no account.
  // Generated by Postgres so existing rows are backfilled on migration.
  trackToken          String         @unique @default(dbgenerated("gen_random_uuid()::text"))
  customerId          String? // linked account (optional — walk-ins have none)
  customer            User?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName        String? // walk-in / legacy owner name when no account
  deviceType          DeviceType
  brand               String?
  model               String?
  issueTitle          String
  issueDescription    String?
  solution            String? // what was actually done
  photos              String[]       @default([])
  status              TicketStatus   @default(RECEIVED)
  receivedItems       Json? // ReceivedItem[] = [{ label, detail? }] — what came in with the device (phone, SIM, cover…)
  estimatedCost       Decimal?       @db.Decimal(10, 2)
  finalCost           Decimal?       @db.Decimal(10, 2)
  discountPercent     Decimal?       @db.Decimal(5, 2)
  // Internal shop bookkeeping — never shown to customers
  partsCost           Decimal?       @db.Decimal(10, 2) // what the shop spent
  paidAmount          Decimal?       @db.Decimal(10, 2) // what the customer paid
  duration            String? // e.g. "2 Hours", "1 Day"
  // PartEntry[] = [{ part, supplier?, cost? }] — one row per part, because a
  // repair needing several parts often sources them from different suppliers.
  // partsUsed/partsSupplier below are kept in sync as flat summaries so older
  // reads (and the legacy bill line) keep working.
  parts               Json?
  partsUsed           String? // e.g. "Display, Battery"
  partsSupplier       String? // e.g. "Trans Asia Cellular"
  forgottenParts      String? // QA tracking, e.g. "3 Screws"
  adminNotes          String?
  billNotes           String? // customer-facing notes shown on the bill (diagnosis, cancellation reason, etc.)
  // Admin-built itemised bill — when set, drives the on-screen bill + PDF
  // instead of the single auto-computed line. See src/lib/bill.ts.
  technician          String? // who carried out the repair, printed on the bill
  billItems           Json? // BillLineItem[] = [{ label, amount }] — bill line items
  billDiscountPercent Decimal?       @db.Decimal(5, 2) // bill discount as a % of the subtotal
  billDiscountAmount  Decimal?       @db.Decimal(10, 2) // bill discount as a flat LKR amount
  billPayTo           Json? // { bankName, branch, accountName, accountNumber } — where to pay, shown on unpaid invoices
  billGeneratedAt     DateTime? // when the bill was first generated — the invoice date/time
  paidAt              DateTime? // when the shop manually marked the bill paid (drives the receipt/PAID stamp)
  paidMethod          String? // e.g. "Cash", "Bank transfer" — printed on the paid receipt
  warrantyPeriod      String? // e.g. "3 months" — only shown when the warranty field is enabled
  warrantyParts       String? // e.g. "Display, Battery" — what the warranty covers
  issueWarranty       String? // warranty offered on a free fix after an issue during the repair
  billShow            Json? // BillShow — per-field visibility toggles for the bill
  // Issues during repair — see the RepairIssue model. A repair can hit more
  // than one (another mishap after the first was fixed), so they're rows.
  issues              RepairIssue[]
  refunded            Boolean        @default(false) // a refund was agreed for damage
  statusUpdates       StatusUpdate[]
  payments            Payment[]
  testimonials        Testimonial[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  completedAt         DateTime?

  @@index([customerId])
  @@index([status])
}

// Something went wrong at the shop while the device was in its hands. The
// shop reports what happened plus an optional free-of-charge fix; the
// customer accepts (repair continues at no charge) or declines (repair is
// cancelled with a refund for the damage). A repair can hit several of
// these in sequence — only one may be awaiting a decision at a time.
model RepairIssue {
  id         String            @id @default(cuid())
  ticketId   String
  ticket     RepairTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  status     RepairIssueStatus @default(PENDING)
  note       String // what went wrong
  solution   String? // the proposed free fix; null = no fix possible
  // PartEntry[] = [{ part, supplier?, cost? }] — what the shop had to buy to
  // put its own mistake right. Pure shop expense: it feeds partsCost/profit
  // and the error reports, and is never printed on the customer's bill.
  parts      Json?
  reportedAt DateTime          @default(now())
  resolvedAt DateTime? // when the customer (or shop on their behalf) decided
  createdAt  DateTime          @default(now())

  @@index([ticketId])
}

model StatusUpdate {
  id        String       @id @default(cuid())
  ticketId  String
  ticket    RepairTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  status    TicketStatus
  note      String?
  photo     String? // optional image attached to this entry (e.g. handover photo at pickup)
  createdAt DateTime     @default(now())

  @@index([ticketId])
}

model Payment {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketId   String?
  ticket     RepairTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  orderId    String?
  order      Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  amount     Decimal       @db.Decimal(10, 2)
  method     PaymentMethod
  status     PaymentStatus @default(PENDING)
  receiptUrl String? // bank-transfer receipt upload
  reference  String? // bank ref / PayHere payment id
  adminNote  String? // reason on rejection
  verifiedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

// ─── Storefront ──────────────────────────────────────────────────────

model Product {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String
  category    ProductCategory
  price       Decimal         @db.Decimal(10, 2)
  stock       Int             @default(0)
  images      String[]        @default([])
  visible     Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  orderItems  OrderItem[]

  @@index([category, visible])
}

model Order {
  id          String      @id @default(cuid())
  seq         Int         @unique @default(autoincrement())
  orderNumber String      @unique
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      OrderStatus @default(PENDING)
  total       Decimal     @db.Decimal(10, 2)
  items       OrderItem[]
  payments    Payment[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
}

// ─── Customer feedback (home-page testimonials) ──────────────────────

// A customer's review of the shop. Submitted from /feedback (or added by an
// admin for walk-ins), moderated under Admin → Reviews, and shown on the
// marketing home page once APPROVED.
model Testimonial {
  id          String            @id @default(cuid())
  userId      String? // the account that wrote it — null for admin-added walk-ins
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  ticketId    String? // the repair it's about, when the customer picked one
  ticket      RepairTicket?     @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  name        String // display name shown on the site (customer can shorten it)
  deviceLabel String? // e.g. "iPhone 13 · Screen replacement" — the caption under the name
  rating      Int // 1–5 stars
  message     String
  avatarUrl   String? // snapshot of the author's avatar at submit time
  status      TestimonialStatus @default(PENDING)
  featured    Boolean           @default(false) // pinned to the front of the home-page rail
  sortOrder   Int               @default(0) // admin ordering within the approved list
  adminNote   String? // internal moderation note — never shown publicly
  reviewedAt  DateTime? // when an admin approved or hid it
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, featured, sortOrder])
  @@index([userId])
}

// ─── Loyalty & notifications ─────────────────────────────────────────

model DiscountRule {
  id              String   @id @default(cuid())
  minRepairs      Int // discount applies from this completed-repair count
  discountPercent Decimal  @db.Decimal(5, 2)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@unique([minRepairs])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// ─── Audit log ─────────────────────────────────────────────────────
// Who deleted a repair, or moved money. Nothing writes here except
// lib/audit.ts's logAudit(), called from inside the same transaction as the
// mutation it records — see lib/actions for the call sites. Never exposed as
// deletable in the UI (Admin → Activity is read-only).

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName  String // snapshot — survives the actor's name changing, or (future) being deleted
  actorRole  Role // snapshot
  action     String // dot-namespaced, e.g. "ticket.delete", "bill.markPaid"
  entityType String // e.g. "RepairTicket", "Payment", "DiscountRule", "BankAccount"
  entityId   String? // not an FK — the row (or JSON-array entry) may no longer exist
  meta       Json? // amounts, old/new values — plain JSON; Decimals converted with Number()
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ─── Password reset (email OTP) ──────────────────────────────────────

model PasswordReset {
  id        String   @id @default(cuid())
  email     String   @unique // one active code per email
  codeHash  String // bcrypt hash of the 6-digit code
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

// ─── Settings (key-value, e.g. phone storefront visibility) ─────────

model Setting {
  key   String @id
  value String
}

// ─── Rate limiting ───────────────────────────────────────────────────
// Fixed-window counters for login, registration, password reset and the
// public tracker. Kept in Postgres deliberately: a shop deploying this needs
// zero extra infrastructure, and login volume at one repair shop is nowhere
// near the point where Redis would be worth another service to configure.

model RateLimit {
  key       String   @id // e.g. "login:ip:1.2.3.4" or "login:email:a@b.c"
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}
