# Copy to .env and fill in values

# PostgreSQL connection string (local Docker or Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/mobilux"

# Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_TRUST_HOST=true

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Production file storage (Vercel Blob). Leave unset in local dev —
# uploads fall back to public/uploads on disk.
# BLOB_READ_WRITE_TOKEN=""
