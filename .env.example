# Copy to .env and fill in values

# PostgreSQL connection string (local Docker or Neon's pooled URL)
DATABASE_URL="postgresql://user:password@localhost:5432/mobilux"

# Direct (non-pooled) connection, used only by `prisma migrate`.
# Locally this can be the same as DATABASE_URL. On Neon/Vercel, use the
# "non-pooling" connection string (no "-pooler" in the hostname) —
# PgBouncer's transaction pooling can't hold the advisory lock migrate needs.
DIRECT_URL="postgresql://user:password@localhost:5432/mobilux"

# Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_TRUST_HOST=true

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Production file storage (Vercel Blob). Leave unset in local dev —
# uploads fall back to public/uploads on disk.
# BLOB_READ_WRITE_TOKEN=""
