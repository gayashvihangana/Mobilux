# Copy to .env and fill in values

# ─── Required ────────────────────────────────────────────────────────

# PostgreSQL connection string (local Docker or Neon's pooled URL)
DATABASE_URL="postgresql://user:password@localhost:5432/mobilux"

# Session signing key. MUST be unique per deployment — two shops sharing this
# means a login token minted for one validates at the other.
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Canonical site URL, no trailing slash. Printed bills' QR codes and every
# email link are built from this, so a wrong value sends your customers to
# someone else's tracker. On Vercel this is detected automatically from the
# project domain — set it only for a custom domain or self-hosting.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Shop identity (shown on the site, bills and emails) ─────────────
# All public, none secret. These are the FIRST-RUN fallbacks only — they make
# a fresh install look right before anyone has signed in. Once a shop owner
# saves their details under Admin → Settings, the saved values win everywhere
# (logo, footer, tab title, emails, bills, tracker) with no redeploy, and
# these are never read again. Settings also has a logo mark and brand colour
# with no env equivalent.

NEXT_PUBLIC_SHOP_NAME="Your Shop"
NEXT_PUBLIC_SHOP_TAGLINE="Fix. Track. Trust."
NEXT_PUBLIC_SHOP_PHONE="+94 71 234 5678"
NEXT_PUBLIC_SHOP_EMAIL="hello@yourshop.lk"
NEXT_PUBLIC_SHOP_CITY="Colombo, Sri Lanka"
NEXT_PUBLIC_SHOP_HOURS="Mon–Sat, 9:00 AM – 7:00 PM"
# Digits only, international format. Leave blank to hide the WhatsApp buttons.
NEXT_PUBLIC_SHOP_WHATSAPP="94712345678"
# Days of warranty printed on bills when none is set per repair.
NEXT_PUBLIC_WARRANTY_DAYS="30"
# Optional. One warm line at the foot of every bill. Defaults to
# "Your device, in trusted hands — thank you for choosing <shop name>."
NEXT_PUBLIC_BILL_QUOTE=""

# ─── Bank details printed on unpaid bills ────────────────────────────
# Fallback only — the live accounts are managed under Admin → Settings →
# Bank accounts, and a bill freezes the account it was issued against.

NEXT_PUBLIC_BANK_NAME=""
NEXT_PUBLIC_BANK_BRANCH=""
NEXT_PUBLIC_BANK_ACCOUNT_NAME=""
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=""

# ─── Seeding ─────────────────────────────────────────────────────────
# `npm run db:seed` refuses to run against a production database unless both
# of these are set — otherwise it would create the public default admin login.
# SEED_ADMIN_EMAIL="owner@yourshop.lk"
# SEED_ADMIN_PASSWORD=""          # min 12 characters
# SEED_ADMIN_NAME="Shop Owner"

# ─── Demo instance only ────────────────────────────────────────────────
# Leave all three unset on a real shop's deployment. They apply only to the
# second, throwaway Vercel project + Neon DB — see docs/OPERATIONS.md §6.

# Flips on the demo banner, the one-click login buttons, hides Register, and
# blocks password changes. Requires a redeploy (NEXT_PUBLIC_*).
# NEXT_PUBLIC_DEMO_MODE="true"

# Shared secret the nightly reset cron presents in its Authorization header.
# Generate with: openssl rand -base64 32
# CRON_SECRET=""

# The demo Neon database's hostname (from its DATABASE_URL) — a second,
# independent check that the reset route is really talking to the demo
# database before it truncates anything.
# DEMO_DATABASE_HOST=""

# ─── Optional services ───────────────────────────────────────────────

# Production file storage (Vercel Blob). Leave unset in local dev —
# uploads fall back to public/uploads on disk.
# BLOB_READ_WRITE_TOKEN=""

# Transactional email (Resend — https://resend.com, free tier is fine).
# Leave unset to disable email; in-app notifications still work.
# RESEND_API_KEY=""
# Sender shown to customers. Domain must be verified in Resend.
# EMAIL_FROM="Your Shop <hello@yourshop.lk>"

# Optional: production (Neon) connection, used only by `npm run db:pull`
# to copy live data into your local DB for testing. Read-only from prod.
# PROD_DATABASE_URL=""

# Note: on Vercel, migrations run via scripts/migrate-deploy.mjs, which
# derives Neon's direct (non-pooled) connection from DATABASE_URL
# automatically — no DIRECT_URL env var needed.
