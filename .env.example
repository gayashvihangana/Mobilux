# Copy to .env and fill in values

# PostgreSQL connection string (local Docker or Neon's pooled URL)
DATABASE_URL="postgresql://user:password@localhost:5432/mobilux"

# Optional: production (Neon) connection, used only by `npm run db:pull`
# to copy live data into your local DB for testing. Read-only from prod.
# PROD_DATABASE_URL=""

# Note: on Vercel, migrations run via scripts/migrate-deploy.mjs, which
# derives Neon's direct (non-pooled) connection from DATABASE_URL
# automatically — no DIRECT_URL env var needed.

# Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_TRUST_HOST=true

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Production file storage (Vercel Blob). Leave unset in local dev —
# uploads fall back to public/uploads on disk.
# BLOB_READ_WRITE_TOKEN=""
